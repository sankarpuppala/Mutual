# Copy to server/deploy/.env (gitignored) and fill in. Never commit the filled-in file.

# Your public hostname, e.g. mutual.example.org or yourname.duckdns.org (free).
MUTUAL_DOMAIN=

# A long random secret that keys every stored email hash. Generate once with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# and never change it: changing it orphans every account.
MUTUAL_EMAIL_PEPPER=

# SMTP account that sends login codes (see docs/DEPLOYMENT.md for free options).
MUTUAL_SMTP_USER=
MUTUAL_SMTP_PASSWORD=
